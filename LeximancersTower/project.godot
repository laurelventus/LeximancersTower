; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Leximancers Tower"
run/main_scene="res://scenes/core/main_menu.tscn"
config/features=PackedStringArray("4.6")

[autoload]

AudioManager="*res://scripts/autoload/audio_manager.gd"
Localization="*res://scripts/autoload/localization.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
PuzzleManager="*res://scripts/autoload/puzzle_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
Inventory="*res://scripts/autoload/inventory.gd"
SpellBook="*res://scripts/autoload/spell_book.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
McpInteractionServer="*res://scripts/autoload/mcp_interaction_server.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

